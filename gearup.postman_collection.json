    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set environment variables for testing",
          "pm.environment.set(\"base_url\", \"http://localhost:5000\");",
          "pm.environment.set(\"email\", \"test@example.com\");",
          "pm.environment.set(\"password\", \"password123\");"
        ],
        "type": "text/javascript"
      }
    }
  ],
  "variable": [
