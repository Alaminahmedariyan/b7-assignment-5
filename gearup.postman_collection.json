              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"gearId\": \"{{gear_id}}\",\n    \"startDate\": \"2026-07-10\",\n    \"endDate\": \"2026-07-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/rentals",
              "host": ["{{base_url}}"],
              "path": ["rentals"]
            }
          }
        }
      ]
    },
    {
